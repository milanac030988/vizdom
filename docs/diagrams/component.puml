@startuml Component_Diagram
!pragma layout smetana
top to bottom direction

skinparam backgroundColor #FEFEFE
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam componentStyle rectangle
skinparam nodesep 16
skinparam ranksep 40
skinparam component {
    BorderColor #555555
    ArrowColor #333333
}

title VizDOM - Component Diagram (hexagonal)\nPackage-level wiring; per-class internals are in the class detail diagrams.\nDependencies point inward; red dashed = tracked hexagon debt.

' ============================================================
' 1 - Consumers (driving side)
' ============================================================
package "Consumers (driving)" #F3E5F5 {
    [visual_dom_viewer\n(PyQt5)] as viewer
    [dashboard\n(Streamlit)] as dash
    [visual_gui_library\nkeywords + locators (RF)] as kw
    [context.py\nconnect() / Session] as ctx
}

' ============================================================
' 2 - Domain core (visual_dom.core) — pure, inward
' ============================================================
package "visual_dom.core" #FFF3E0 {
    [core.domain.pipeline\nVisualDOMPipeline\n(orchestrator)] as pipeline
    [core.domain services\nhierarchy · compiler · schema\ncvops · reading_order] as domain
    package "core.ports.outbound" #FFECB3 {
        interface "detector_port" as dport
        interface "capture_port" as cport
        interface "actuator_port" as aport
    }
}

' ============================================================
' 3 - Driven adapters (visual_dom.adapters.outbound)
'     one registry + one strategy-set box per family
' ============================================================
package "adapters.outbound" #E8F5E9 {
    package "detectors" #DCEDC8 {
        [registry\ncreate_detector] as dreg
        [uied_backend] as duied
        [yolo_backend] as dyolo
        [omniparser_backend] as domni
        [grpc_backend\n(remote)] as dgrpc
        [uied_detection\n(classical algo)] as uiedcore
        ' stack the backends vertically so the package stays a narrow column
        duied -[hidden]down- dyolo
        dyolo -[hidden]down- domni
        domni -[hidden]down- dgrpc
        dgrpc -[hidden]down- uiedcore
    }
    package "ocr" #DCEDC8 {
        [text_detector] as ocrd
    }
    package "refiner" #DCEDC8 {
        [slm_advisor] as slm
    }
    package "capture\n(ADR-018)" #E1F5FE {
        [registry] as creg
        [windows/linux/android/camera\n+ gRPC + plugins] as cimpl
    }
    package "actuator\n(ADR-019)" #E1F5FE {
        [registry] as areg
        [desktop/android\n+ gRPC + plugins] as aimpl
    }
}

' ============================================================
' 3b - Driving adapters + generated stubs
' ============================================================
package "adapters.inbound.grpc\n(ADR-017)" #EDE7F6 {
    [detector / capture / actuator\ngRPC servers] as servers
    [generated\n*_pb2 stubs] as gen
}

cloud "External" #FAFAFA {
    [OCR engines · YOLO · OmniParser · Ollama] as ext
}

' ============================================================
' Edges (few, top-down)
' ============================================================
' consumers / composition root -> core
ctx --> pipeline : builds from config
viewer --> pipeline
dash --> pipeline
kw --> pipeline : detect / DOM
kw --> creg : capture
kw --> areg : actuate

' core depends on ports + its own domain services
pipeline --> dport
pipeline --> domain
' direct OCR/refiner use = tracked hexagon debt
pipeline ..> ocrd #Red;text:Red : debt
pipeline ..> slm #Red;text:Red : debt

' detectors: registry builds each backend (within package); UIED wraps the classical algo
dreg --> duied
dreg --> dyolo
dreg --> domni
dreg --> dgrpc
duied --> uiedcore
domni ..> ocrd : OCR ensemble

' capture/actuator: registry builds the strategy set (within package)
creg --> cimpl
areg --> aimpl

' adapters realise the ports (one edge per family, keeps it untangled)
dport <|.. dreg : impl. by backends
cport <|.. creg : impl. by strategies
aport <|.. areg : impl. by strategies

' driving adapters reuse the registries; stubs shared
servers --> dreg
servers --> creg
servers --> areg
servers --> gen

' external dependencies (consolidated)
dyolo --> ext
domni --> ext
ocrd --> ext
slm --> ext

@enduml
