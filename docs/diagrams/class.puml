@startuml Class_Diagram
!pragma layout smetana
top to bottom direction

skinparam backgroundColor #FEFEFE
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0
skinparam nodesep 14
skinparam ranksep 34
skinparam class {
    BorderColor #555555
    ArrowColor #333333
}
skinparam packageStyle rectangle
hide empty members

title VizDOM - Class Diagram (core)\nConcrete strategies collapsed per port; the spine is the data flow Detection -> UIElement -> TreeNode -> DOMNode.

' ============================================================
' PORTS (core.ports.outbound) — stacked vertically (hidden edges) to stay narrow
' ============================================================
package "core.ports.outbound" #FFECB3 {
    abstract class DetectorBackend {
        +name / license / requires_gpu
        +{abstract} detect(img): List<Detection>
    }
    abstract class CaptureStrategy {
        +name / platform
        +{abstract} capture(): ndarray
    }
    abstract class ActuatorStrategy {
        +{abstract} tap / type_text / press_key
        +{abstract} scroll / swipe
        +device_size() / _to_device()
    }
    DetectorBackend -[hidden]down- CaptureStrategy
    CaptureStrategy -[hidden]down- ActuatorStrategy
}

' ============================================================
' DRIVEN ADAPTERS (adapters.outbound) — one collapsed box per port, stacked
' ============================================================
package "adapters.outbound" #E8F5E9 {
    class "detectors\nUIED · YOLO · OmniParser · Grpc\n+ registry create_detector()\n+ UIEDDetector (classical)\n+ ocr.TextDetector · refiner.SLMAdvisor" as DetImpls
    class "capture (ADR-018)\nWindows/Linux/Android/Camera/Grpc\n+ registry create_capture()" as CapImpls
    class "actuator (ADR-019)\nDesktop/Android/Grpc\n+ registry create_actuator()" as ActImpls
    DetImpls -[hidden]down- CapImpls
    CapImpls -[hidden]down- ActImpls
}

' ============================================================
' DOMAIN (core.domain) — orchestration + the data-model spine
' ============================================================
package "core.domain" #FFF3E0 {
    class VisualDOMPipeline {
        +detector_mode: str
        +process(image): dict
        -_merge_oversegmented_elements()
        -_slm_review()
    }
    class Detection <<dataclass>> {
        +bounds / visual_type / confidence
        +text / label / interactable / source
    }
    class UIElement <<dataclass>> {
        +id / bounds / visual_type
        +ocr_text / label / interactable
        +to_dict(): dict
    }
    class CoarseHierarchyBuilder {
        +build(elements): dict
    }
    class TreeNode <<dataclass>> {
        +id / bounds / role
        +text / hint / label
        +children: List<TreeNode>
    }
    class DOMCompiler {
        +compile(elements, hierarchy, size): dict
    }
    class DOMNode <<dataclass>> {
        +id / bounds / role / visual_type
        +clickable / editable / scrollable
        +locators: dict
        +children: List<DOMNode>
    }
}

' ============================================================
' CONSUMER (thin client)
' ============================================================
package "visual_gui_library (RF)" #F3E5F5 {
    class Keywords {
        actions / assertions / capture
        (orchestrates capture + actuator)
    }
    class Locator
}

' ============================================================
' Relationships — adapters implement ports (inward); domain spine flows down
' ============================================================
DetImpls ..|> DetectorBackend
CapImpls ..|> CaptureStrategy
ActImpls ..|> ActuatorStrategy

' pipeline depends on the ports (not the concretes)
VisualDOMPipeline --> DetectorBackend : detect
DetectorBackend ..> Detection : returns

' the data-model spine (top -> bottom)
Detection ..> UIElement : converted to
UIElement ..> CoarseHierarchyBuilder : input
CoarseHierarchyBuilder ..> TreeNode : builds
CoarseHierarchyBuilder ..> DOMCompiler : tree
DOMCompiler ..> DOMNode : emits

' consumer
DOMNode ..> Locator : located by
Locator --> Keywords
Keywords --> CaptureStrategy : capture
Keywords --> ActuatorStrategy : actuate


' ============================================================
' CROSSCUTTING / SHARED  (used by every package above)
' ============================================================
package "shared (crosscutting)" #ECEFF1 {
    class "logging_utils" as Logging <<module>> {
        +get_logger(name): Logger
        +configure_logging(level, file, console)
        +log_timing(logger, label)
        --one channel, three sinks--
        rotating file  logs/vizdom.log
        console
        Robot log (bridge handler)
    }
    class VizDomConfig {
        detector / ocr / refiner / merge
        hierarchy / symbols / filter
        capture / actuator / grounding / output
        +load(path|dict) / to_dict() / save()
    }
}

note bottom of Logging
  **Dependencies deliberately not drawn.** Every class in every
  package above calls get_logger(__name__); arrows would add ~20
  edges and hide the data-flow spine this diagram exists to show.
  Names are re-homed under the visual_dom namespace with a layer
  tag (visual_dom.rf.* / .viewer.* / .adapters.*) so a line is
  never misattributed. See arc42 Ch.8 (Crosscutting Concepts).
end note

note bottom of VizDomConfig
  One session config (ADR-020) selects the strategies and tunes
  every stage; the ports above are chosen BY NAME from it, which
  is why no arrow points at a concrete adapter.
end note
@enduml
