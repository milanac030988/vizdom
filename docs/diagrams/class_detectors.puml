@startuml Class_Detectors
!pragma layout smetana
top to bottom direction
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0
skinparam nodesep 16
skinparam ranksep 34
skinparam class {
    BorderColor #555555
    ArrowColor #333333
}
hide empty members

title Detail - Detector port & adapters\n(core.ports.outbound.detector_port + adapters.outbound.detectors)

package "core.ports.outbound.detector_port" #FFECB3 {
    abstract class DetectorBackend {
        +name: str
        +description: str
        +license: str
        +requires_gpu: bool
        +{abstract} detect(image): List<Detection>
        +{static} is_available(): bool
    }
    class Detection <<dataclass>> {
        +bounds: (x1,y1,x2,y2)
        +visual_type: str
        +confidence: float
        +text: Optional<str>
        +label: Optional<str>
        +interactable: Optional<bool>
        +source: str
        +parent_id / children_ids
        +extra: dict
    }
}

package "core.ports.outbound.stage_ports (ADR-027)" #FFECB3 {
    abstract class RegionProposer {
        +name / license / requires_gpu
        +{abstract} propose(image): List<RegionProposal>
    }
    class RegionProposal <<dataclass>> {
        +bounds: (x1,y1,x2,y2)
        +confidence: float
    }
    abstract class Captioner {
        +name / license / requires_gpu
        +{abstract} caption(image, boxes): List<Optional<str>>
    }
}

package "adapters.outbound.detectors" #E8F5E9 {
    class Registry <<module>> {
        +create_detector(name, kwargs)
        +list_detectors()
        +register(name, factory, meta)
    }
    class UIEDBackend
    class YOLOBackend
    class OmniParserBackend {
        +box_threshold: float
        +ocr_provider: Callable
        +ocr_ensemble: bool
        -_infer_visual_type()
    }
    class GrpcDetectorBackend {
        +target: str
    }
    class UIEDDetector {
        +min_element_area / nms_threshold
        +detect(image): List<DetectedElement>
    }
    class DetectedElement <<dataclass>> {
        +bounds / element_type / confidence
    }
    class ModularDetectorBackend {
        +region_proposer / captioner: name|instance
        +ocr_engine: str
        +detect(image): List<Detection>
    }
    class "modular_fusion.fuse()" as Fusion <<module>> {
        keep-smaller region pairs
        absorb OCR inside region (>0.80)
        drop region inside OCR
    }
    class "OmniParserRegionProposer\nUIEDRegionProposer" as RegionImpls
    class "FlorenceCaptioner\nNoneCaptioner" as CaptionerImpls
}

UIEDBackend --|> DetectorBackend
YOLOBackend --|> DetectorBackend
OmniParserBackend --|> DetectorBackend
GrpcDetectorBackend --|> DetectorBackend
ModularDetectorBackend --|> DetectorBackend
DetectorBackend ..> Detection : returns
Registry ..> DetectorBackend : creates
UIEDBackend --> UIEDDetector : wraps
UIEDDetector ..> DetectedElement : returns
GrpcDetectorBackend ..> Detection : (remote server\nreturns Detections)

' ADR-027: the modular backend composes three replaceable stages + fusion.
' Stage 2 (text) reuses ocr.TextDetector - shared with the pipeline instance.
RegionImpls --|> RegionProposer
CaptionerImpls --|> Captioner
ModularDetectorBackend --> RegionProposer : stage 1
ModularDetectorBackend --> Captioner : stage 3 (optional)
ModularDetectorBackend --> Fusion : stages 1+2 -> fused boxes
RegionProposer ..> RegionProposal : returns

' ---- layout only: break the backend sprawl into two rows and put the ADR-027
' ---- stage ports below the detector port instead of beside it
UIEDBackend -[hidden]down-> ModularDetectorBackend
YOLOBackend -[hidden]down-> Fusion
OmniParserBackend -[hidden]down-> RegionImpls
GrpcDetectorBackend -[hidden]down-> CaptionerImpls
Detection -[hidden]down-> RegionProposer
@enduml
