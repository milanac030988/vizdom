# User's own session config (keep the tracked template vizdom.config.example.json)
/vizdom.config.json

# Scratch / personal working files (never part of the project)
tmp/

# OS
.DS_Store
Thumbs.db

# Runtime logs (visual_dom.logging_utils)
logs/

# ProperDocs build output
tools/plantuml.jar
site/

# Vendored external code (AGPL-3.0, reconstruct via scripts/setup_omniparser.py).
# Not a submodule: the corporate proxy blocks GitHub, so clones can't fetch it.
third_party/

# Model weights (large; reconstruct via scripts/setup_omniparser.py + HuggingFace).
# GitHub rejects files >100MB (icon_caption_florence/model.safetensors is ~1GB).
# Keep models/configs/*.py (source) tracked.
models/omniparser/
*.safetensors
*.pt
*.pth
*.onnx

# Camera-augmented dataset (~580MB, reconstructable via scripts/data_prep/augment_camera.py).
# Keep data/synthetic/ (the labelled benchmark) tracked.
data/synthetic_camera/
# Internal automotive HMI screens with Label Studio exports: not for the public repository
data/da3/

# Thesis material kept on the author's machine, not part of the public project:
# the defence decks and scripts, the LaTeX reports and the paper draft.
docs/present/
report/
paper/
docs/handoff-*
docs/DeCuong-Thacsi-Updated.md

# gRPC stubs: generated by scripts/gen_protos.py (the release pipeline does)
src/visual_dom/generated/*_pb2.py
src/visual_dom/generated/*_pb2_grpc.py
