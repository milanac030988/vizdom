# Vendored external code (AGPL-3.0, reconstruct via scripts/setup_omniparser.py).
# Not a submodule: the corporate proxy blocks GitHub, so clones can't fetch it.
third_party/

# Model weights (large; reconstruct via scripts/setup_omniparser.py + HuggingFace).
# GitHub rejects files >100MB (icon_caption_florence/model.safetensors is ~1GB).
# Keep models/configs/*.py (source) tracked.
models/omniparser/
*.safetensors
*.pt
*.pth
*.onnx

# Camera-augmented dataset (~580MB, reconstructable via scripts/data_prep/augment_camera.py).
# Keep data/synthetic/ (the labelled benchmark) tracked.
data/synthetic_camera/

# LaTeX build artifacts (report/). Keep .tex, .bib, and figures/ tracked.
report/*.aux
report/*.log
report/*.bbl
report/*.blg
report/*.out
report/*.toc
report/*.pdf
report/*.xdv
report/*.fls
report/*.fdb_latexmk
