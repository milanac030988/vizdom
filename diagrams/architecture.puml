@startuml Architecture
' Uses Graphviz (dot) for clean top-to-bottom layering (needs dot / GRAPHVIZ_DOT).
' The other diagrams stay Smetana (graphviz-free). Keep this file ASCII-only.
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ranksep 45
skinparam nodesep 22
skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #666666
    ArrowColor #333333
}

title VizDOM - Hexagonal Architecture + Distributed Services\n(detector ADR-017, capture ADR-018, actuator ADR-019)

package "Driving adapters (inbound)" #E3F2FD {
    [CLI\nprocess_gui_image] as cli
    [Visual DOM Viewer] as viewer
    [Dashboard] as dash
    [Robot Framework lib\n(thin client)] as rf
}

package "Domain core (pure, local, CPU)" #FFF3E0 {
    [Pipeline orchestration] as pipe
    [Reading-order + Smart-merge] as merge
    [Coarse hierarchy] as hier
    [DOM compiler + schema] as compiler
    interface "DetectorPort" as dport
    interface "OcrPort" as oport
    interface "RefinerPort" as rport
    interface "CapturePort" as cport
    interface "ActuatorPort" as aport
}

package "Driven adapters - local (in-process)" #E8F5E9 {
    [UIEDBackend] as uied
    [YOLOBackend] as yolo
    [OmniParserBackend] as omni
    [TextDetector] as ocr
    [SLMAdvisor] as slm
    [WindowsCapture] as wcap
    [AndroidCapture] as acap
    [CameraCapture] as ccap
    [DesktopActuator] as dact
    [AndroidActuator] as aact
}

package "Driven adapters - remote" #FCE4EC {
    [GrpcDetectorBackend] as gclient
    [GrpcCaptureStrategy] as gcap
    [GrpcActuatorStrategy] as gact
}

node "GPU host A" #ECEFF1 {
    [Detector gRPC service\n(warm OmniParser/YOLO)] as dsvc
}
node "GPU host B" #ECEFF1 {
    [Ollama\n(minicpm-v / qwen2.5)] as ollama
}
node "SUT host / device / arm controller" #ECEFF1 {
    [Capture gRPC service\n(windows / android / camera)] as csvc
    [Actuator gRPC service\n(desktop / android / robot-arm)] as asvc
}

' inbound -> core (all enter at the pipeline so the core stays one rank band)
cli --> pipe
viewer --> pipe
dash --> pipe
rf --> pipe

' within the core (flat: children one rank below pipe, ports included)
pipe --> merge
pipe --> hier
pipe --> compiler
pipe --> dport
pipe --> oport
pipe --> rport
pipe --> cport
pipe --> aport

' ports -> driven adapters (below the core)
dport --> uied
dport --> yolo
dport --> omni
dport --> gclient
oport --> ocr
rport --> slm
cport --> wcap
cport --> acap
cport --> ccap
cport --> gcap
aport --> dact
aport --> aact
aport --> gact

' remote adapters -> external hosts (bottom)
gclient --> dsvc : gRPC
slm --> ollama : HTTP
gcap --> csvc : gRPC
gact --> asvc : gRPC

@enduml
